# ---- Server ----
PORT=4000
NODE_ENV=production
# Public site origin(s), comma separated (CORS allow-list; REQUIRED in production)
FRONTEND_URL=https://www.example.com
WEBSITE_URL=https://www.example.com
# Where clients land after login (defaults to ${WEBSITE_URL}/agency/account)
WORKSPACE_URL=
TRUST_PROXY=true
JWT_SECRET=change-me-long-random
JWT_EXPIRES_IN=8h
# Optional: separate secret for order links (defaults to JWT_SECRET)
ORDER_TOKEN_SECRET=
GST_RATE=0.18

# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=oct20five

# ---- Payments: razorpay (production) | mock (dev/test only; refuses to boot in production) ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<api>/api/webhooks/payments/razorpay  (events: payment.captured, payment.failed, refund.processed)
RAZORPAY_WEBHOOK_SECRET=
MERCHANT_NAME=OCT20FIVE
# PAYMENT_MOCK_SECRET=dev-only

# ---- Email: smtp (Gmail app password or any SMTP) | console (dev) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OCT20FIVE <hello@oct20five.com>"
SUPPORT_EMAIL=hello@oct20five.com

# ---- Background workers (set to off in tests) ----
MAIL_WORKER=on
ORDER_SWEEPER=on
